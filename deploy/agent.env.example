# RMM agent configuration (copy to /etc/rmm/agent.env and edit)

# Base URL of your RMM server (your domain, HTTPS).
RMM_SERVER_URL=https://rmm.example.com

# The enrollment token from the server's configuration. Used once to enroll;
# after that the agent uses its own issued token stored in RMM_AGENT_STATE.
RMM_ENROLLMENT_TOKEN=change-me-enrollment-token

# Optional: a stable identifier for this machine. Defaults to host-<hostname>.
# RMM_MACHINE_ID=

# Where the agent stores its issued token.
RMM_AGENT_STATE=/opt/rmm-agent/agent-state.json
