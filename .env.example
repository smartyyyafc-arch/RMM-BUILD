# RMM server configuration (copy to .env and adjust)

# HTTP port the server listens on
PORT=8080

# Where the SQLite database file is stored
RMM_DB_PATH=./data/rmm.db

# Admin API key — used by the dashboard and admin API calls.
# Generate a strong random value in production, e.g. `openssl rand -hex 32`.
RMM_ADMIN_KEY=change-me-admin-key

# Enrollment token — agents present this once to enroll and receive
# their own long-lived per-agent token. Rotate it after provisioning.
RMM_ENROLLMENT_TOKEN=change-me-enrollment-token

# An agent is considered offline if it has not sent a heartbeat within
# this many seconds.
RMM_OFFLINE_AFTER_SECONDS=120
